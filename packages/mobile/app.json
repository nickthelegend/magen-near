{
  "expo": {
    "name": "Magen",
    "slug": "magen-near",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "magen",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C0F"
    },
    "ios": {
      "bundleIdentifier": "xyz.magen.near",
      "supportsTablet": false
    },
    "android": {
      "package": "xyz.magen.near"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Magen uses the camera to scan NEAR accounts and Magen pay codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Magen reads a QR code from a photo you pick.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
